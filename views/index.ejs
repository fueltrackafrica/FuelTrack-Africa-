<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weather Dashboard</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="header-content">
        <h1><i class="fas fa-cloud"></i> Weather Dashboard</h1>
        <p>Real-time weather information at your fingertips</p>
      </div>
    </header>

    <!-- Search Section -->
    <section class="search-section">
      <div class="search-box">
        <input 
          type="text" 
          id="cityInput" 
          placeholder="Enter city name..."
          class="search-input"
        >
        <button id="searchBtn" class="search-btn">
          <i class="fas fa-search"></i> Search
        </button>
        <button id="geoBtn" class="geo-btn" title="Use my location">
          <i class="fas fa-map-marker-alt"></i>
        </button>
      </div>
      <div id="errorMessage" class="error-message"></div>
    </section>

    <!-- Current Weather -->
    <section id="currentWeather" class="weather-section hidden">
      <div class="weather-card">
        <div class="weather-header">
          <div class="location-info">
            <h2 id="cityName"></h2>
            <p id="updateTime" class="update-time"></p>
          </div>
          <div class="weather-icon">
            <img id="weatherIcon" src="" alt="Weather icon">
          </div>
        </div>

        <div class="weather-main">
          <div class="temperature">
            <span id="temp" class="temp-value">--</span>
            <span class="temp-unit">°C</span>
          </div>
          <div class="description">
            <p id="weatherDesc">--</p>
            <p id="feelsLike" class="feels-like">Feels like --°C</p>
          </div>
        </div>

        <div class="weather-details">
          <div class="detail-item">
            <i class="fas fa-tint"></i>
            <span class="detail-label">Humidity</span>
            <span id="humidity" class="detail-value">--%</span>
          </div>
          <div class="detail-item">
            <i class="fas fa-wind"></i>
            <span class="detail-label">Wind Speed</span>
            <span id="windSpeed" class="detail-value">-- m/s</span>
          </div>
          <div class="detail-item">
            <i class="fas fa-compress"></i>
            <span class="detail-label">Pressure</span>
            <span id="pressure" class="detail-value">-- hPa</span>
          </div>
          <div class="detail-item">
            <i class="fas fa-cloud"></i>
            <span class="detail-label">Cloudiness</span>
            <span id="cloudiness" class="detail-value">--%</span>
          </div>
          <div class="detail-item">
            <i class="fas fa-sunrise"></i>
            <span class="detail-label">Sunrise</span>
            <span id="sunrise" class="detail-value">--:--</span>
          </div>
          <div class="detail-item">
            <i class="fas fa-sunset"></i>
            <span class="detail-label">Sunset</span>
            <span id="sunset" class="detail-value">--:--</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Forecast Section -->
    <section id="forecastSection" class="forecast-section hidden">
      <h3>5-Day Forecast</h3>
      <div id="forecastContainer" class="forecast-container"></div>
    </section>
  </div>

  <script src="/app.js"></script>
</body>
</html>
